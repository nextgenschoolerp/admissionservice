{
  "info": {
    "_postman_id": "us-02005-student-conversion",
    "name": "School_ERP_US-02005 - Convert Verified Leads into Student Master Records",
    "description": "Postman collection for US-02005: Convert verified candidate leads into active Student Master records.\nActor: Applicant Parent\nModule: Admission Management & Lead CRM\n\nSetup: run the admissionservice (default port 8083) and fill the token variables with JWTs issued by authservice for the listed roles. Requests that need an existing enquiry use {{enquiryId}}; IDs created by positive requests are captured automatically.\nSide effects: positive POST/PATCH requests create or change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "tenant-001",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "branch-001",
      "type": "string"
    },
    {
      "key": "enquiryId",
      "value": "",
      "type": "string",
      "description": "UUID of an existing enquiry (create one with the US-02001 collection)"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string",
      "description": "Captured automatically by the positive request"
    },
    {
      "key": "forbiddenToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with JWT with ROLE_TEACHER (not permitted)"
    },
    {
      "key": "parentToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_APPLICANT_PARENT (guardian email of the enquiry)"
    }
  ],
  "item": [
    {
      "name": "Convert lead into Student Master record - Positive (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{parentToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02005-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/enquiries/{{enquiryId}}/student-conversion",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "enquiries",
            "{{enquiryId}}",
            "student-conversion"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dateOfBirth\": \"2014-05-12\",\n  \"gender\": \"MALE\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('studentId', pm.response.json().data.studentId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Student Master record - Positive (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{parentToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02005-002"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});"
            ]
          }
        }
      ]
    },
    {
