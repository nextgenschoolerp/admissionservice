          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amountPaid\": 15000.0,\n  \"paymentMode\": \"UPI\",\n  \"transactionReference\": \"UPI-778899001\",\n  \"remarks\": \"Paid at front office\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
