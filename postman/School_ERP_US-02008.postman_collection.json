{
  "info": {
    "_postman_id": "us-02008-seat-deposit-receipt",
    "name": "School_ERP_US-02008 - Seat Reservation Deposits & Digital Receipts",
    "description": "Postman collection for US-02008: Collect seat reservation deposit fees and issue digital receipts.\nActor: School Principal\nModule: Admission Management & Lead CRM\n\nSetup: run the admissionservice (default port 8083) and fill the token variables with JWTs issued by authservice for the listed roles. Requests that need an existing enquiry use {{enquiryId}}; IDs created by positive requests are captured automatically.\nSide effects: positive POST/PATCH requests create or change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "tenant-001",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "branch-001",
      "type": "string"
    },
    {
      "key": "enquiryId",
      "value": "",
      "type": "string",
      "description": "UUID of an existing enquiry (create one with the US-02001 collection)"
    },
    {
      "key": "receiptNumber",
      "value": "",
      "type": "string",
      "description": "Captured automatically by the positive request"
    },
    {
      "key": "forbiddenToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with JWT with ROLE_APPLICANT_PARENT (not permitted)"
    },
    {
      "key": "principalToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_SCHOOL_PRINCIPAL"
    }
  ],
  "item": [
    {
      "name": "Collect deposit and issue receipt - Positive (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{principalToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02008-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/offers/{{offerId}}/deposits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "offers",
            "{{offerId}}",
            "deposits"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amountPaid\": 15000.0,\n  \"paymentMode\": \"UPI\",\n  \"transactionReference\": \"UPI-778899001\",\n  \"remarks\": \"Paid at front office\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('receiptNumber', pm.response.json().data.receiptNumber);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get digital receipt - Positive (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{principalToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02008-002"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/deposits/receipts/{{receiptNumber}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "deposits",
            "receipts",
            "{{receiptNumber}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Collect deposit and issue receipt - Negative - validation (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{principalToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/offers/{{offerId}}/deposits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "offers",
            "{{offerId}}",
            "deposits"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentMode\": \"UPI\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.errorCode).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Collect deposit and issue receipt - Negative - unauthenticated (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/offers/{{offerId}}/deposits",
