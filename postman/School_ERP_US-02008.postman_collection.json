    },
    {
      "name": "Not found (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{principalToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/deposits/receipts/RCPT-DOES-NOT-EXIST",
          "host": [
