{
  "info": {
    "_postman_id": "us-02002-entrance-exam",
    "name": "School_ERP_US-02002 - Schedule Entrance Exams & Auto-generate Admit Cards",
    "description": "Postman collection for US-02002: Schedule entrance examination dates and auto-generate candidate admit cards.\nActor: Admission Officer\nModule: Admission Management & Lead CRM\n\nSetup: run the admissionservice (default port 8083) and fill the token variables with JWTs issued by authservice for the listed roles. Requests that need an existing enquiry use {{enquiryId}}; IDs created by positive requests are captured automatically.\nSide effects: positive POST/PATCH requests create or change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "tenant-001",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "branch-001",
      "type": "string"
    },
    {
      "key": "enquiryId",
      "value": "",
      "type": "string",
      "description": "UUID of an existing enquiry (create one with the US-02001 collection)"
    },
    {
      "key": "examId",
      "value": "",
      "type": "string",
      "description": "Captured automatically by the positive request"
    },
    {
      "key": "counselorToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_FRONT_OFFICE_COUNSELOR"
    },
    {
      "key": "forbiddenToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with JWT with ROLE_FRONT_OFFICE_COUNSELOR (not permitted)"
    },
    {
      "key": "officerToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_ADMISSION_OFFICER"
    }
  ],
  "item": [
    {
      "name": "Schedule exam and generate admit cards - Positive (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{officerToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02002-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/entrance-exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "entrance-exams"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"examTitle\": \"Grade 6 Entrance Test 2026\",\n  \"academicYearId\": \"ay-2026\",\n  \"targetGradeId\": \"grade-6\",\n  \"examStartAt\": \"2026-12-05T04:00:00Z\",\n  \"durationMinutes\": 90,\n  \"venue\": \"Main Hall, Block A\",\n  \"maxMarks\": 100,\n  \"passingMarks\": 40,\n  \"reportingInstructions\": \"Report 30 minutes early with a pencil\",\n  \"enquiryIds\": [\n    \"{{enquiryId}}\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('examId', pm.response.json().data.examId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get exam with admit cards - Positive (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{officerToken}}"
          },
