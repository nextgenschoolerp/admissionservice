{
  "info": {
    "_postman_id": "us-02003-applicant-evaluation",
    "name": "School_ERP_US-02003 - Evaluate Applicants with Standardized Rubric",
    "description": "Postman collection for US-02003: Evaluate applicant interview scores using standardized rubric criteria.\nActor: Registrar\nModule: Admission Management & Lead CRM\n\nSetup: run the admissionservice (default port 8083) and fill the token variables with JWTs issued by authservice for the listed roles. Requests that need an existing enquiry use {{enquiryId}}; IDs created by positive requests are captured automatically.\nSide effects: positive POST/PATCH requests create or change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "tenant-001",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "branch-001",
      "type": "string"
    },
    {
      "key": "enquiryId",
      "value": "",
      "type": "string",
      "description": "UUID of an existing enquiry (create one with the US-02001 collection)"
    },
    {
      "key": "evaluationId",
      "value": "",
      "type": "string",
      "description": "Captured automatically by the positive request"
    },
    {
      "key": "forbiddenToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with JWT with ROLE_MARKETING_MANAGER (not permitted)"
    },
    {
      "key": "registrarToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_REGISTRAR"
    }
  ],
  "item": [
    {
      "name": "Get standardized rubric - Positive (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{registrarToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02003-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/evaluation-rubrics?evaluationType=INTERVIEW",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "evaluation-rubrics"
          ],
          "query": [
            {
              "key": "evaluationType",
              "value": "INTERVIEW"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Record rubric evaluation - Positive (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{registrarToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02003-002"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/evaluations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "evaluations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enquiryId\": \"{{enquiryId}}\",\n  \"evaluationType\": \"INTERVIEW\",\n  \"passingScore\": 50,\n  \"feedbackNotes\": \"Articulate and confident\",\n  \"rubricScores\": [\n    {\n      \"criterion\": \"COMMUNICATION\",\n      \"awardedScore\": 18\n    },\n    {\n      \"criterion\": \"ACADEMIC_APTITUDE\",\n      \"awardedScore\": 26\n    },\n    {\n      \"criterion\": \"GENERAL_AWARENESS\",\n      \"awardedScore\": 15\n    },\n    {\n      \"criterion\": \"CONFIDENCE_AND_CONDUCT\",\n      \"awardedScore\": 12\n    },\n    {\n      \"criterion\": \"PARENT_INTERACTION\",\n      \"awardedScore\": 13\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('evaluationId', pm.response.json().data.evaluationId);",
              "}"
            ]
          }
        }
      ]
    },
