            "conversion-rates"
          ],
          "query": [
            {
              "key": "tenantId",
              "value": "{{tenantId}}"
            },
            {
              "key": "fromDate",
              "value": "2026-01-01"
            },
            {
              "key": "toDate",
              "value": "2026-10-31"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Conversion report - Negative - forbidden role FINANCE_CASHIER (403)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{forbiddenToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/analytics/conversion-rates?tenantId={{tenantId}}&fromDate=2026-01-01&toDate=2026-10-31",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
