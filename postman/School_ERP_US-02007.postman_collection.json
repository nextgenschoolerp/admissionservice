{
  "info": {
    "_postman_id": "us-02007-lead-conversion-analytics",
    "name": "School_ERP_US-02007 - Lead Conversion Rates by Channel",
    "description": "Postman collection for US-02007: Track lead conversion rates across marketing channels and referral sources.\nActor: Marketing Manager\nModule: Admission Management & Lead CRM\n\nSetup: run the admissionservice (default port 8083) and fill the token variables with JWTs issued by authservice for the listed roles. Requests that need an existing enquiry use {{enquiryId}}; IDs created by positive requests are captured automatically.\nSide effects: positive POST/PATCH requests create or change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "tenant-001",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "branch-001",
      "type": "string"
    },
    {
      "key": "enquiryId",
      "value": "",
      "type": "string",
      "description": "UUID of an existing enquiry (create one with the US-02001 collection)"
    },
    {
      "key": "forbiddenToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with JWT with ROLE_FINANCE_CASHIER (not permitted)"
    },
    {
      "key": "marketingToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_MARKETING_MANAGER"
    }
  ],
  "item": [
    {
      "name": "Conversion report - Positive (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{marketingToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02007-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/analytics/conversion-rates?tenantId={{tenantId}}&fromDate=2026-01-01&toDate=2026-10-31",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "analytics",
            "conversion-rates"
          ],
          "query": [
            {
              "key": "tenantId",
              "value": "{{tenantId}}"
            },
            {
              "key": "fromDate",
              "value": "2026-01-01"
            },
            {
              "key": "toDate",
              "value": "2026-10-31"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Conversion report - Negative - validation (400)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{marketingToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/analytics/conversion-rates",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "analytics",
            "conversion-rates"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.errorCode).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Conversion report - Negative - unauthenticated (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/analytics/conversion-rates?tenantId={{tenantId}}&fromDate=2026-01-01&toDate=2026-10-31",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
