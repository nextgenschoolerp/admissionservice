            "merit-lists"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"academicYearId\": \"ay-2026\",\n  \"targetGradeId\": \"grade-6\",\n  \"entranceTestWeight\": 1.5,\n  \"interviewWeight\": 0\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.errorCode).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Generate merit list - Negative - unauthenticated (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
