{
  "info": {
    "_postman_id": "us-02010-merit-list",
    "name": "School_ERP_US-02010 - Weighted Merit Ranking of Candidates",
    "description": "Postman collection for US-02010: Rank candidates automatically based on weighted entrance test scores.\nActor: Admission Officer\nModule: Admission Management & Lead CRM\n\nSetup: run the admissionservice (default port 8083) and fill the token variables with JWTs issued by authservice for the listed roles. Requests that need an existing enquiry use {{enquiryId}}; IDs created by positive requests are captured automatically.\nSide effects: positive POST/PATCH requests create or change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "tenant-001",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "branch-001",
      "type": "string"
    },
    {
      "key": "enquiryId",
      "value": "",
      "type": "string",
      "description": "UUID of an existing enquiry (create one with the US-02001 collection)"
    },
    {
      "key": "meritListId",
      "value": "",
      "type": "string",
      "description": "Captured automatically by the positive request"
    },
    {
      "key": "forbiddenToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with JWT with ROLE_REGISTRAR (not permitted)"
    },
    {
      "key": "officerToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_ADMISSION_OFFICER"
    }
  ],
  "item": [
    {
      "name": "Generate merit list - Positive (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{officerToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02010-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/merit-lists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "merit-lists"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"academicYearId\": \"ay-2026\",\n  \"targetGradeId\": \"grade-6\",\n  \"entranceTestWeight\": 0.7,\n  \"interviewWeight\": 0.3\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('meritListId', pm.response.json().data.meritListId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get merit list - Positive (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{officerToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02010-002"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/merit-lists/{{meritListId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "merit-lists",
            "{{meritListId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Generate merit list - Negative - validation (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{officerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/merit-lists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
