{
  "info": {
    "_postman_id": "us-02004-applicant-document-vault",
    "name": "School_ERP_US-02004 - Applicant Document Vault Upload",
    "description": "Postman collection for US-02004: Upload mandatory birth certificates and transfer records to the document vault.\nActor: Entrance Exam Evaluator\nModule: Admission Management & Lead CRM\n\nSetup: run the admissionservice (default port 8083) and fill the token variables with JWTs issued by authservice for the listed roles. Requests that need an existing enquiry use {{enquiryId}}; IDs created by positive requests are captured automatically.\nSide effects: positive POST/PATCH requests create or change data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "tenant-001",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "branch-001",
      "type": "string"
    },
    {
      "key": "enquiryId",
      "value": "",
      "type": "string",
      "description": "UUID of an existing enquiry (create one with the US-02001 collection)"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string",
      "description": "Captured automatically by the positive request"
    },
    {
      "key": "evaluatorToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_ENTRANCE_EXAM_EVALUATOR"
    },
    {
      "key": "forbiddenToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with JWT with ROLE_APPLICANT_PARENT (not permitted)"
    },
    {
      "key": "registrarToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token with ROLE_REGISTRAR"
    }
  ],
  "item": [
    {
      "name": "Upload document (multipart: file, documentType) - Positive (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{evaluatorToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02004-001"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/enquiries/{{enquiryId}}/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "enquiries",
            "{{enquiryId}}",
            "documents"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "birth_certificate.pdf"
            },
            {
              "key": "documentType",
              "value": "BIRTH_CERTIFICATE",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('documentId', pm.response.json().data.documentId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List vault documents - Positive (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{evaluatorToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02004-002"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/enquiries/{{enquiryId}}/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "enquiries",
            "{{enquiryId}}",
            "documents"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify or reject document - Positive (200)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{registrarToken}}"
          },
          {
            "key": "X-Trace-Id",
            "value": "postman-us-02004-003"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admissions/documents/{{documentId}}/verification",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admissions",
            "documents",
            "{{documentId}}",
            "verification"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verificationStatus\": \"VERIFIED\",\n  \"verificationNotes\": \"Original sighted at front office\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response envelope', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('X-Trace-Id header present', function () {",
              "  pm.response.to.have.header('X-Trace-Id');",
              "});"
            ]
          }
        }
      ]
    },
